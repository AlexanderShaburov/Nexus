{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/soki-bootstrap.py",
            "timeout": 15,
            "statusMessage": "SOKI bootstrap"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/soki-bootstrap.py",
            "timeout": 15,
            "statusMessage": "SOKI re-bootstrap"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/soki-prompt-gate.py",
            "timeout": 15,
            "statusMessage": "SOKI turn contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|LS|NotebookRead|Edit|Write|MultiEdit|NotebookEdit|Bash|Task|Agent|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/soki-tool-gate.py",
            "timeout": 15,
            "statusMessage": "SOKI tool gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/soki-exit-gate.py",
            "timeout": 15,
            "statusMessage": "SOKI exit gate"
          }
        ]
      }
    ]
  }
}

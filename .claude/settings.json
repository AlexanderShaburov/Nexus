{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/nexus-bootstrap.py",
            "timeout": 15,
            "statusMessage": "NEXUS bootstrap"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/nexus-bootstrap.py",
            "timeout": 15,
            "statusMessage": "NEXUS re-bootstrap"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/nexus-prompt-gate.py",
            "timeout": 15,
            "statusMessage": "NEXUS turn contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|LS|NotebookRead|Edit|Write|MultiEdit|NotebookEdit|Bash|Task|Agent|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/nexus-tool-gate.py",
            "timeout": 15,
            "statusMessage": "NEXUS tool gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/nexus-exit-gate.py",
            "timeout": 15,
            "statusMessage": "NEXUS exit gate"
          }
        ]
      }
    ]
  }
}

          <mxGeometry x="400" y="720" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="X1" value="deny: разрешены только read-инструменты" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="735" width="120" height="60" as="geometry" />

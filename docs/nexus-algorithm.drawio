        <mxCell id="D3n" value="проверка по порядку: флаг хода уже установлен → claim из tool_input.command → текст «### Context Decision» в транскрипте" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="400" y="1055" width="340" height="36" as="geometry" />

        <mxCell id="OK" value="allow → turn.decision_gate_seen = true" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">

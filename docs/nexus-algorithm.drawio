        <mxCell id="E4" value="PostToolUse&lt;br&gt;(Edit / Write / MultiEdit / NotebookEdit)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1190" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="H5" value="&lt;b&gt;nexus-vault-validator.py&lt;/b&gt; (advisory, не блокирует)&lt;br&gt;файл под knowledge/**.md → правила tools/validate-vault.py&lt;br&gt;→ findings в контекст; молчит, если документ чист; никогда не правит" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="1180" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A6" value="&lt;b&gt;Ground + Sync&lt;/b&gt;&lt;br&gt;работа с учётом инвариантов и спек, конфликты — явно;&lt;br&gt;writeback в vault (plans / specs / decisions / bugs / feedback);&lt;br&gt;python3 tools/validate-vault.py; commit вместе с кодом" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="1190" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="A7" value="&lt;b&gt;Closure Block&lt;/b&gt; в конце ответа&lt;br&gt;code changed / KB changed / session log written / writeback evaluation performed (+ «KB unchanged because …»)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="1320" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="E5" value="Stop&lt;br&gt;(конец ответа агента)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">

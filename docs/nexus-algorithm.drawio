        <mxCell id="E1" value="SessionStart / PreCompact" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="H1" value="&lt;b&gt;nexus-bootstrap.py&lt;/b&gt;&lt;br&gt;сброс .nexus/state.json (bootstrap = pending);&lt;br&gt;инъекция Mandatory Startup Reading Set в контекст первого хода" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="140" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="H1b" value="&lt;b&gt;nexus-update-check.py&lt;/b&gt; (не блокирует, молчит при сбоях)&lt;br&gt;хост: раз в 24 ч один git ls-remote --tags (5 с), одна строка, если есть новый тег v*;&lt;br&gt;шаблон: число заметок в feedback-inbox при каждом старте" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="240" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A1" value="&lt;b&gt;Агент читает обязательный набор&lt;/b&gt;&lt;br&gt;invariants/* → architecture--system--overall-structure → spec knowledge-driven-task-orchestration → index--system--project-navigation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="140" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="H2" value="&lt;b&gt;nexus-tool-gate.py&lt;/b&gt; (PreToolUse, пока bootstrap = pending)&lt;br&gt;разрешены только Read / Glob / Grep / LS / NotebookRead, на любом пути;&lt;br&gt;каждое Read нужного файла → read-ledger;&lt;br&gt;набор прочитан полностью → bootstrap = completed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="350" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="&lt;b&gt;«Session Bootstrap Completed»&lt;/b&gt;&lt;br&gt;агент выводит блок подтверждения; режим Knowledge-Driven: ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="360" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="E2" value="UserPromptSubmit&lt;br&gt;(запрос пользователя)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="H3" value="&lt;b&gt;nexus-prompt-gate.py&lt;/b&gt;&lt;br&gt;сброс per-turn флагов (decision_gate_seen = false);&lt;br&gt;инъекция контракта хода: Decision Gate + Exit Gate&lt;br&gt;(или напоминание «bootstrap не завершён»)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="480" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A3" value="&lt;b&gt;Retrieve&lt;/b&gt;&lt;br&gt;агент читает нужные документы vault:&lt;br&gt;index → declared relations → остановка при достаточном контексте" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="480" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A4" value="&lt;b&gt;Context Decision&lt;/b&gt; (один раз за ход)&lt;br&gt;claim: python3 tools/nexus-decide.py --kb YES|NO --reads … --reason …&lt;br&gt;или текст «### Context Decision» в ответе" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="600" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="E3" value="PreToolUse&lt;br&gt;(мутирующий инструмент: Edit / Write / MultiEdit / NotebookEdit / Bash / Task)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;spacing=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="730" width="300" height="70" as="geometry" />
        </mxCell>

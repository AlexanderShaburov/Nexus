# Nexus runtime state (regenerated per session)
# Glob, not a literal: catches macOS/iCloud duplicates like ".nexus/state 2.json"
.nexus/state*.json

# Nexus patch backups (regenerated per patch apply)
.nexus/backups/

# Nexus upstream version-check cache (written by the SessionStart notifier)
.nexus/update-check.json

# Built patch zips (regenerated by tools/build-patch-zip.sh)
dist/

# Python bytecode caches
__pycache__/
*.pyc

# Personal per-user Claude Code settings (not team-shared)
.claude/settings.local.json

# Obsidian per-user UI state (open panes and layout; rewritten on every use).
# The rest of knowledge/.obsidian/ — app, appearance, core-plugins, graph —
# stays tracked: that is shared vault configuration.
# Glob also covers workspace-mobile.json.
knowledge/.obsidian/workspace*.json

# macOS
.DS_Store

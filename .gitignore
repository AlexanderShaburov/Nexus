# Nexus runtime state (regenerated per session)
.nexus/state.json

# Nexus patch backups (regenerated per patch apply)
.nexus/backups/

# Built patch zips (regenerated by tools/build-patch-zip.sh)
dist/

# Python bytecode caches
__pycache__/
*.pyc

# Personal per-user Claude Code settings (not team-shared)
.claude/settings.local.json

# macOS
.DS_Store
